# ImgFlow Docker Environment Configuration
# Copy this file to .env and modify as needed

# Environment
NODE_ENV=production

# Service Ports (non-standard range to avoid conflicts)
IMGPROXY_PORT=33001
WESERV_PORT=33007
FLYIMG_PORT=33008

# Imgproxy Configuration
IMGPROXY_LOCAL_STORAGE_ENABLED=false
IMGPROXY_ALLOWED_SOURCES=*
IMGPROXY_MAX_SRC_RESOLUTION=50
IMGPROXY_MAX_SRC_FILE_SIZE=50000000
IMGPROXY_QUALITY=85
IMGPROXY_FORMATS=jpg,jpeg,png,webp,avif

# Volume mounts
IMGPROXY_VOLUME_SOURCE=./assets/images

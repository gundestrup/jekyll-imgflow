# ImgFlow Test Environment Configuration

# Environment
NODE_ENV=test

# Test port blocks (four ports per provider/job; port 4000 is reserved for development Jekyll)
TEST_PORT_BLOCK_SIZE=4
SHARP_PORT=4010
LIBVIPS_PORT=4014
IMAGEMAGICK_PORT=4018
IMGPROXY_PORT=4022
WESERV_PORT=4026
FLYIMG_PORT=4030
WESERV_LIMIT_INPUT_PIXELS=100000000
CROSS_PROVIDER_PORT=4034
PERFORMANCE_PORT=4038
GENERAL_TEST_PORT=4042

# Imgproxy Configuration (for local file access)
IMGPROXY_LOCAL_STORAGE_ENABLED=false
IMGPROXY_ALLOWED_SOURCES=*
IMGPROXY_MAX_SRC_RESOLUTION=50
IMGPROXY_MAX_SRC_FILE_SIZE=50000000
IMGPROXY_QUALITY=85
IMGPROXY_FORMATS=jpg,jpeg,png,webp,avif
IMGPROXY_LOCAL_FILESYSTEM_ROOT=/app/images
IMGPROXY_ALLOW_SOURCES=local

# Volume mounts (for testing)
IMGPROXY_VOLUME_SOURCE=./spec/fixtures/originals
